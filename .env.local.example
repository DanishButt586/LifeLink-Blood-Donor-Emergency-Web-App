# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Anthropic Claude API Key (for "Ask LifeLink" eligibility chatbot)
# Do not share or expose this key to client-side code!
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server-only key used in advanced backend queries
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
