# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API key for the "Ask LifeLink" eligibility chatbot.
# Accepts an Anthropic, OpenRouter, DeepSeek, OpenAI, or Google Gemini key.
# Do not share or expose this key to client-side code!
ANTHROPIC_API_KEY=your_api_key_here

# Which AI provider the key above belongs to: openrouter | anthropic | deepseek | openai | gemini
# Optional — leave unset and the provider is guessed from the key prefix. But OpenAI and
# DeepSeek keys both look like "sk-...", so set this explicitly when using OpenAI.
# AI_PROVIDER=openai

# Server-only key used in advanced backend queries
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
